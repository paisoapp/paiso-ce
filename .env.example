# Optional settings for Paiso. None is needed: the defaults run a complete
# install. In Docker, set them on the `paiso-ce` service in docker-compose.yml.
# For a development backend, copy this file to backend/.env.

# The header your HTTPS proxy sets to the visitor's address, so sign-in limits
# count each visitor separately. Leave empty unless a proxy you control sets
# it on every request (X-Real-IP with the Caddy example in README.md,
# CF-Connecting-IP behind Cloudflare).
# PAISO_TRUSTED_IP_HEADER=

# false stops the background jobs (market prices, transfer pairing).
# PAISO_SCHEDULER=true

# Generated into $PAISO_STORAGE_ROOT/secrets/ on the first start when unset.
# Set them only to bring your own.
# PAISO_JWT_SECRET=
# PAISO_MASTER_KEY=

# Where the data lives. The image sets both; a development backend needs them.
# PAISO_SQLITE_PATH=/data/paiso.db
# PAISO_STORAGE_ROOT=/data

# How long a sign-in token lasts (minutes) and how long a device stays signed
# in without use (days).
# PAISO_JWT_ACCESS_EXPIRE_MINUTES=60
# PAISO_JWT_REFRESH_EXPIRE_DAYS=30

# false stops the start-up migrations (run python -m app.core.migrations).
# PAISO_AUTO_MIGRATE=true

# Other origins allowed to call the API with the session, as a JSON list.
# PAISO_ALLOWED_ORIGINS=["https://example.com"]
